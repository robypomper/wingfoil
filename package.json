  "description": "Open-source harness for AI-assisted software development that makes the process deterministic — Project Memory, Project DNA, Project Directives, Project Workflow, and a CLI + MCP interaction layer.",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "bin": {
    "wingfoil": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "eslint .",
